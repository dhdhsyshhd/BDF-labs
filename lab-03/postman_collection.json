{
  "info": {
    "_postman_id": "lab03-rest-api-collection",
    "name": "Lab 03 - REST API, Query Parameters, Validation & Debugging",
    "description": "Comprehensive Postman test collection for Backend Development Fundamentals Lab 03 at Aurora.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Success Cases",
      "item": [
        {
          "name": "1. Retrieve All Books",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books",
              "host": ["{{baseUrl}}"],
              "path": ["books"]
            }
          }
        },
        {
          "name": "2. Search by Partial Title",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books?search_q=fire",
              "host": ["{{baseUrl}}"],
              "path": ["books"],
              "query": [
                { "key": "search_q", "value": "fire" }
              ]
            }
          }
        },
        {
          "name": "3. Sort by Price Ascending",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books?order_by=price&order=ASC",
              "host": ["{{baseUrl}}"],
              "path": ["books"],
              "query": [
                { "key": "order_by", "value": "price" },
                { "key": "order", "value": "ASC" }
              ]
            }
          }
        },
        {
          "name": "4. Sort by Price Descending",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books?order_by=price&order=DESC",
              "host": ["{{baseUrl}}"],
              "path": ["books"],
              "query": [
                { "key": "order_by", "value": "price" },
                { "key": "order", "value": "DESC" }
              ]
            }
          }
        },
        {
          "name": "5. Filter by Price Range",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books?min_price=250&max_price=450",
              "host": ["{{baseUrl}}"],
              "path": ["books"],
              "query": [
                { "key": "min_price", "value": "250" },
                { "key": "max_price", "value": "450" }
              ]
            }
          }
        },
        {
          "name": "6. Pagination (Limit & Offset)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books?limit=5&offset=0",
              "host": ["{{baseUrl}}"],
              "path": ["books"],
              "query": [
                { "key": "limit", "value": "5" },
                { "key": "offset", "value": "0" }
              ]
            }
          }
        },
        {
          "name": "7. Combined Query Parameters",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books?search_q=the&order_by=price&order=ASC&min_price=100&max_price=600&limit=5&offset=0",
              "host": ["{{baseUrl}}"],
              "path": ["books"],
              "query": [
                { "key": "search_q", "value": "the" },
                { "key": "order_by", "value": "price" },
                { "key": "order", "value": "ASC" },
                { "key": "min_price", "value": "100" },
                { "key": "max_price", "value": "600" },
                { "key": "limit", "value": "5" },
                { "key": "offset", "value": "0" }
              ]
            }
          }
        },
        {
          "name": "8. Retrieve Book by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books/1",
              "host": ["{{baseUrl}}"],
              "path": ["books", "1"]
            }
          }
        },
        {
          "name": "9. Create Valid Book",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Designing Data-Intensive Applications\",\n  \"author\": \"Martin Kleppmann\",\n  \"price\": 850,\n  \"pages\": 616\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/books",
              "host": ["{{baseUrl}}"],
              "path": ["books"]
            }
          }
        },
        {
          "name": "10. Update Existing Book",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Wings of Fire (Illustrated Edition)\",\n  \"author\": \"A.P.J. Abdul Kalam\",\n  \"price\": 350,\n  \"pages\": 220\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/books/1",
              "host": ["{{baseUrl}}"],
              "path": ["books", "1"]
            }
          }
        },
        {
          "name": "11. Delete Existing Book",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books/11",
              "host": ["{{baseUrl}}"],
              "path": ["books", "11"]
            }
          }
        },
        {
          "name": "12. Lab 1 Compatibility - GET /about",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/about",
              "host": ["{{baseUrl}}"],
              "path": ["about"]
            }
          }
        },
        {
          "name": "13. Lab 1 Compatibility - GET /time",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/time",
              "host": ["{{baseUrl}}"],
              "path": ["time"]
            }
          }
        }
      ]
    },
    {
      "name": "Failure & Validation Cases",
      "item": [
        {
          "name": "1. POST Missing Title (400)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"author\": \"Robert Martin\",\n  \"price\": 500\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/books",
              "host": ["{{baseUrl}}"],
              "path": ["books"]
            }
          }
        },
        {
          "name": "2. POST Missing Author (400)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Clean Architecture\",\n  \"price\": 500\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/books",
              "host": ["{{baseUrl}}"],
              "path": ["books"]
            }
          }
        },
        {
          "name": "3. POST Price as String Text (400)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Title\",\n  \"author\": \"Author\",\n  \"price\": \"free_edition\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/books",
              "host": ["{{baseUrl}}"],
              "path": ["books"]
            }
          }
        },
        {
          "name": "4. POST Negative Price (400)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Title\",\n  \"author\": \"Author\",\n  \"price\": -100\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/books",
              "host": ["{{baseUrl}}"],
              "path": ["books"]
            }
          }
        },
        {
          "name": "5. Unsupported Order By Field (400)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books?order_by=non_existent_column",
              "host": ["{{baseUrl}}"],
              "path": ["books"],
              "query": [
                { "key": "order_by", "value": "non_existent_column" }
              ]
            }
          }
        },
        {
          "name": "6. Invalid Order Direction (400)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books?order=SIDEWAYS",
              "host": ["{{baseUrl}}"],
              "path": ["books"],
              "query": [
                { "key": "order", "value": "SIDEWAYS" }
              ]
            }
          }
        },
        {
          "name": "7. Min Price Greater Than Max Price (400)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books?min_price=600&max_price=200",
              "host": ["{{baseUrl}}"],
              "path": ["books"],
              "query": [
                { "key": "min_price", "value": "600" },
                { "key": "max_price", "value": "200" }
              ]
            }
          }
        },
        {
          "name": "8. Invalid Limit Parameter (400)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books?limit=-10",
              "host": ["{{baseUrl}}"],
              "path": ["books"],
              "query": [
                { "key": "limit", "value": "-10" }
              ]
            }
          }
        },
        {
          "name": "9. Retrieve Non-Existent Book ID (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books/9999",
              "host": ["{{baseUrl}}"],
              "path": ["books", "9999"]
            }
          }
        },
        {
          "name": "10. Update Non-Existent Book ID (404)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Title\",\n  \"author\": \"Author\",\n  \"price\": 200\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/books/9999",
              "host": ["{{baseUrl}}"],
              "path": ["books", "9999"]
            }
          }
        },
        {
          "name": "11. Delete Non-Existent Book ID (404)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books/9999",
              "host": ["{{baseUrl}}"],
              "path": ["books", "9999"]
            }
          }
        },
        {
          "name": "12. Malformed JSON Body (400)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{ broken_json: "
            },
            "url": {
              "raw": "{{baseUrl}}/books",
              "host": ["{{baseUrl}}"],
              "path": ["books"]
            }
          }
        }
      ]
    }
  ]
}
